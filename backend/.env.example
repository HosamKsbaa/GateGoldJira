APP_ENV=development
PORT=21080
DATABASE_URL=postgres://gategoldjira:local-development-only@127.0.0.1:54329/gategoldjira?sslmode=disable
COMPANY_TIMEZONE=Africa/Cairo
AUTH_MODE=development
AUTH_ISSUER=http://localhost:21080/development-identity/
REST_AUDIENCE=http://localhost:21080/api
MCP_AUDIENCE=http://localhost:21080/mcp
AUTH_REQUIRED_SCOPE=gategoldjira:access
# Shared HTTPS/OIDC browser OAuth broker; local development login stays enabled.
MCP_BROWSER_OAUTH_ENABLED=false
DEV_SIGNING_KEY_FILE=../.local/identity/signing-key.pem
STORAGE_MODE=local
LOCAL_PICTURE_DIRECTORY=../.local/pictures
CURSOR_SECRET_FILE=../.local/cursor-secret
ALLOWED_ORIGINS=http://localhost:4201,http://127.0.0.1:4201
# In-app due reminders run each minute in local development. Production uses
# the protected scheduled maintenance job; SMTP is disabled unless configured.
NOTIFICATION_APP_URL=http://localhost:4201
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
# SMTP_ADDRESS=smtp.example.com:587
# SMTP_FROM=jira@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_LOCAL_PLAINTEXT=false

# Native resumable files; pictures stay at most 10 MiB. Hard cap: 100 MiB.
MAXIMUM_ATTACHMENT_BYTES=10485760
