    * plain_text_summary : text
    * created_at : timestamptz
    read_at : timestamptz
    * revision : bigint
    * show_in_app : boolean
    --
    {field} UNIQUE (event_id, issue_id, recipient_id)
  }

  entity "notification_preferences" as notification_preferences {
    * user_id : uuid <<PK,FK>>
    --
    * in_app_enabled : boolean
    * events : text[]
