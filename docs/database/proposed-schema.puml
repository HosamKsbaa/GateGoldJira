package "Accounts and projects" {
  entity "company_settings" as company_settings {
    * singleton : boolean <<PK>>
    --
    * time_zone : text
    * cleanup_paused : boolean
  }

  entity "users" as users {
    * id : uuid <<PK>>
    --
    * email : text
    * email_key : text <<UK>>
    * display_name : text
    approved_at : timestamptz
    disabled_at : timestamptz
    * is_administrator : boolean
    * revision : bigint
    * created_at : timestamptz
    * updated_at : timestamptz
    --
    {field} UNIQUE (email_key)
  }

  entity "user_identities" as user_identities {
    * issuer : text <<PK>>
    * subject : text <<PK>>
    --
    * user_id : uuid <<FK,UK>>
    * bound_at : timestamptz
    --
    {field} UNIQUE (user_id)
  }

  entity "projects" as projects <<refactored>> {
    * id : uuid <<PK>>
    --
    * key : text <<UK>>
    * name : text
    * description : text
    * created_by : uuid <<FK>>
    * next_issue_number : bigint
    * revision : bigint
    * graph_revision : bigint
    archived_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    * backlog_revision : bigint
    * workflow_revision : bigint
    --
    {field} UNIQUE (key)
  }

  ' workflow_revision guards stage/transition/default-limit edits.
  ' Metadata, graph and backlog revisions remain independent.
  entity "project_memberships" as project_memberships {
    * project_id : uuid <<PK,FK>>
    * user_id : uuid <<PK,FK>>
    --
    * role : text
    * revision : bigint
    removed_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
  }

}

package "Workflow and boards" {
  entity "project_stages" as project_stages <<refactored>> {
    * id : uuid <<PK>>
    --
    * project_id : uuid <<FK>>
    * legacy_status : text
    * name : text
    * category : text
    * position : bigint
    * order_revision : bigint
    * retired : boolean
    * default_wip_limit : integer
    --
    {field} UNIQUE (project_id, id)
    {field} UNIQUE (project_id, legacy_status)
  }

  ' Replaces project_status_order and stage definitions in board JSON.
  ' category: todo | in_progress | review | done; immutable once used.
  ' default_wip_limit: 0 = unlimited; positive = warning threshold.
  ' legacy_status preserves existing API tokens and audit meaning.
  ' Retired rows stay; order_revision protects shared card ordering.
  entity "project_stage_transitions" as project_stage_transitions <<new>> {
    * project_id : uuid <<PK,FK>>
    * from_stage_id : uuid <<PK,FK>>
    * to_stage_id : uuid <<PK,FK>>
  }

  ' One set of allowed moves per project; guarded by workflow_revision.
  ' Service validates active endpoints and paths to completion.
  entity "boards" as boards <<refactored>> {
    * id : uuid <<PK>>
    --
    * project_id : uuid <<FK>>
    * name : text
    * name_key : text
    * created_by : uuid <<FK>>
    * is_default : boolean
    * saved_filters : jsonb
    * filters_version : integer
    * revision : bigint
    archived_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    --
    {field} UNIQUE (project_id, id)
    {field} UNIQUE (project_id, name_key)
  }

  ' Board owns filters and local WIP overrides.
  ' All boards share project stages, transitions and column order.
  ' revision guards board settings; workflow_revision is returned separately.
  entity "board_stage_limits" as board_stage_limits <<new>> {
    * board_id : uuid <<PK,FK>>
    * stage_id : uuid <<PK,FK>>
    --
    * project_id : uuid <<FK>>
    * warning_limit : integer
  }

  ' Missing row = inherit project stage default.
  ' 0 = explicitly unlimited; positive = warning threshold.
  ' Effective limit: board override, then stage default.
  ' Changed transactionally with boards.revision.
}

package "Issues" {
  entity "issues" as issues <<refactored>> {
    * id : uuid <<PK>>
    --
    * project_id : uuid <<FK>>
    * number : bigint
    * title : text
    * description : text
    * type : text
    * priority : text
    * stage_id : uuid <<FK>>
    * reporter_id : uuid <<FK>>
    assignee_id : uuid <<FK>>
    due_date : date
    parent_id : uuid <<FK>>
    * rank : bigint
    * revision : bigint
    * created_at : timestamptz
    * updated_at : timestamptz
    * description_format : text
    * archived : boolean
    * backlog : boolean
    * backlog_rank : bigint
    --
    {field} UNIQUE (project_id, id)
    {field} UNIQUE (project_id, number)
  }

  ' Typed StageID replaces encoded status in the core model.
  ' Legacy API status is resolved through project_stages.legacy_status.
  ' Parent, blockers, rank, backlog and metadata revisions are retained.
  entity "labels" as labels {
    * id : uuid <<PK>>
    --
    * project_id : uuid <<FK>>
    * name : text
    * name_key : text
    * created_by : uuid <<FK>>
    * created_at : timestamptz
    --
    {field} UNIQUE (project_id, id)
    {field} UNIQUE (project_id, name_key)
  }

  entity "issue_labels" as issue_labels {
    * issue_id : uuid <<PK,FK>>
    * label_id : uuid <<PK,FK>>
    --
    * project_id : uuid <<FK>>
  }

  entity "issue_dependencies" as issue_dependencies {
    * dependent_id : uuid <<PK,FK>>
    * blocker_id : uuid <<PK,FK>>
    --
    * project_id : uuid <<FK>>
    * revision : bigint
    * created_by : uuid <<FK>>
    * created_at : timestamptz
    removed_by : uuid <<FK>>
    removed_at : timestamptz
  }

  entity "issue_links" as issue_links <<refactored>> {
    * issue_id : uuid <<PK,FK>>
    * target_id : uuid <<PK,FK>>
    * kind : text <<PK>>
    --
    * project_id : uuid <<FK>>
    * created_by : uuid <<FK>>
    * created_at : timestamptz
    removed_at : timestamptz
  }

  ' Same-project links enforced with composite foreign keys.
  ' Keep relates_to and duplicates distinct from completion blockers.
  entity "issue_watchers" as issue_watchers {
    * issue_id : uuid <<PK,FK>>
    * user_id : uuid <<PK,FK>>
    --
    * watching : boolean
    * updated_at : timestamptz
  }

  entity "saved_issue_searches" as saved_issue_searches {
    * id : uuid <<PK>>
    --
    * user_id : uuid <<FK>>
    * name : text
    * filters : jsonb
    * revision : bigint
    * removed : boolean
    * updated_at : timestamptz
  }

}

package "Collaboration and files" {
  entity "comments" as comments {
    * id : uuid <<PK,FK>>
    --
    * project_id : uuid <<FK>>
    * issue_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    * revision : bigint <<FK>>
    * created_at : timestamptz
    edited_at : timestamptz
    --
    {field} UNIQUE (issue_id, id)
  }

  entity "comment_versions" as comment_versions {
    * comment_id : uuid <<PK,FK>>
    * revision : bigint <<PK>>
    --
    * issue_id : uuid <<FK>>
    * safe_html : text
    * plain_text : text
    * created_at : timestamptz
    --
    {field} UNIQUE (comment_id, revision, issue_id)
  }

  entity "comment_version_mentions" as comment_version_mentions {
    * comment_id : uuid <<PK,FK>>
    * version : bigint <<PK,FK>>
    * user_id : uuid <<PK,FK>>
    --
    * display_label_snapshot : text
  }

  entity "comment_version_attachments" as comment_version_attachments <<refactored>> {
    * comment_id : uuid <<PK,FK>>
    * version : bigint <<PK,FK>>
    * attachment_id : uuid <<PK,FK>>
    --
    * issue_id : uuid <<FK>>
  }

  ' Retains immutable version-to-asset references within the same issue.
  ' Supports inline images and retained file links; renderer checks asset kind.
  entity "attachments" as attachments <<refactored>> {
    * id : uuid <<PK>>
    --
    * project_id : uuid <<FK>>
    * issue_id : uuid <<FK>>
    * uploaded_by : uuid <<FK>>
    * kind : text
    * filename : text
    * description : text
    * mime_type : text
    * byte_size : bigint
    * checksum : text
    * staging_key : text <<UK>>
    * staging_generation : bigint
    published_key : text <<UK>>
    published_generation : bigint
    * state : text
    * visible_on_issue : boolean
    * uploaded_at : timestamptz
    expires_at : timestamptz
    published_at : timestamptz
    --
    {field} UNIQUE (issue_id, id)
    {field} UNIQUE (published_key)
    {field} UNIQUE (staging_key)
  }

  ' Unifies pictures and files; retain original UUIDs and object keys.
  ' kind: image | file; state: draft | published | expired.
  ' Draft/expired assets are images with an expiry; drafts are uploader-only.
  ' Published requires object key, generation and published_at.
  ' visible_on_issue requires published; detach preserves history.
  ' Only validated images render inline; files use download disposition.
  entity "upload_reservations" as upload_reservations <<refactored>> {
    * actor_id : uuid <<PK,FK>>
    * retry_reference : uuid <<PK>>
    --
    * operation : text
    * kind : text
    * publication_mode : text
    * command_hash : text
    * attachment_id : uuid <<UK>>
    * project_id : uuid <<FK>>
    * issue_id : uuid <<FK>>
    * staging_key : text <<UK>>
    staging_generation : bigint
    published_key : text
    published_generation : bigint
    * lease_until : timestamptz
    checksum : text
    * state : text
    * created_at : timestamptz
    * updated_at : timestamptz
    --
    {field} UNIQUE (attachment_id)
    {field} UNIQUE (staging_key)
  }

  ' Unifies both reservation tables and upload state machines.
  ' publication_mode: inline_draft | publish_now; file requires publish_now.
  ' Keep operation, canonical hash, actor/retry key, leases and generations.
  ' attachment_id is reserved before asset insertion: intentionally no FK.
  ' ready draft requires staged bytes; ready publish_now also requires published bytes.
}

package "History and reliable commands" {
