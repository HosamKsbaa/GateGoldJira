package "Notifications" {
  entity "notifications" as notifications {
    * id : uuid <<PK>>
    --
    * recipient_id : uuid <<FK>>
    * event_id : uuid <<FK>>
    * project_id : uuid <<FK>>
    * issue_id : uuid <<FK>>
    * actor_id : uuid <<FK>>
