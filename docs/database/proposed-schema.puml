    {field} UNIQUE (event_id)
  }

  entity "notification_deliveries" as notification_deliveries {
    * id : uuid <<PK>>
    --
    * recipient_id : uuid <<FK>>
    * issue_id : uuid <<FK>>
    * notification_id : uuid <<FK,UK>>
    * dedup_key : text <<UK>>
    * state : text
    * attempts : integer
    * available_at : timestamptz
    * created_at : timestamptz
    completed_at : timestamptz
    --
    {field} UNIQUE (dedup_key)
    {field} UNIQUE (notification_id)
  }

}

