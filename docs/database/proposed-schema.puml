    * resource_id : uuid
    project_id : uuid <<FK>>
    issue_id : uuid <<FK>>
    * changes : jsonb
    * created_at : timestamptz
  }

  entity "idempotency_records" as idempotency_records {
    * actor_id : uuid <<PK,FK>>
    * retry_reference : uuid <<PK>>
    --
    * operation : text
    * canonical_input_hash : text
    result : jsonb
    * result_version : integer
    * created_at : timestamptz
    * expires_at : timestamptz
  }

}

