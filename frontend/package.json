{
  "name": "gategoldjira-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-ts",
    "typecheck:tests": "tsc -p tsconfig.spec.json",
    "generate:fixture": "openapi-ts --input ../backend/tests/contracts/openapi-fixture.json --output src/app/api/fixture-generated"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@auth0/auth0-angular": "2.13.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.3",
    "ast-v8-to-istanbul": "1.0.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "typescript": "6.0.3",
    "v8-to-istanbul": "9.3.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "browser-tabs-lock@1.3.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
