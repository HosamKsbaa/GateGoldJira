[Unit]
Description=GateGoldJira immutable release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gategoldjira
Group=gategoldjira
WorkingDirectory=/var/lib/gategoldjira
EnvironmentFile=/etc/gategoldjira/runtime.env
EnvironmentFile=/opt/gategoldjira/releases/%i/release.env
Environment=GOMEMLIMIT=256MiB
Environment=GOMAXPROCS=2
LoadCredential=signing-key.pem:/etc/gategoldjira/identity/signing-key.pem
LoadCredential=accounts.json:/etc/gategoldjira/identity/accounts.json
LoadCredential=cursor-secret:/etc/gategoldjira/identity/cursor-secret
ExecStart=/opt/gategoldjira/releases/%i/gategoldjira
StateDirectory=gategoldjira
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
